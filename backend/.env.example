# Where the collected inputs live (default: backend/data/source)
EVISION_USER_DATA=

# data.gov.in API key. The shared demo key works but is capped at 10 records per
# request and rate-limits quickly; register at https://data.gov.in for a real quota.
EVISION_DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Seconds between requests to the same host.
EVISION_REQUEST_DELAY=1.5
EVISION_REQUEST_TIMEOUT=60
